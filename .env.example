# ==============================================================================
# Nurul Amin Degree College - Production Environment Template (Neon PostgreSQL)
# ==============================================================================

# 1. Neon PostgreSQL Pooled Connection (PgBouncer):
# Used by Next.js Serverless runtime for API routes & web queries
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/nadc_portal?sslmode=require"

# 2. Neon PostgreSQL Direct Connection (Unpooled):
# Used by Prisma CLI for running migrations ('prisma migrate deploy')
DIRECT_URL="postgresql://user:password@ep-sample.region.aws.neon.tech/nadc_portal?sslmode=require"

# 3. Session Secret (cryptographically random, minimum 32 characters):
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-this-to-a-secure-random-32-char-secret-in-production"

# 4. Optional Initial Main Admin Provisioning (Used once by 'npm run provision:admin'):
# MAIN_ADMIN_NAME="Md. Example Admin"
# MAIN_ADMIN_USERNAME="admin"
# MAIN_ADMIN_EMAIL="admin@nurulamindegreecollege.edu.bd"
# MAIN_ADMIN_PASSWORD="StrongSecurePassword123!"

# 5. Optional Allowed Origins (for custom domains or preview deployments):
# ALLOWED_ORIGINS="https://your-custom-domain.edu.bd,https://your-app.vercel.app"
